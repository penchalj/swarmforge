common --enable_bzlmod
build --incompatible_strict_action_env
build --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
test  --test_output=errors

build:release -c opt

try-import %workspace%/user.bazelrc

# CI: keep downloads and action results in ~/.cache, where the workflow
# saves and restores them between runs.
common:ci --repository_cache=/home/ubuntu/.cache/bazel-repo
common:ci --color=yes --curses=no --show_progress_rate_limit=10
build:ci --disk_cache=/home/ubuntu/.cache/bazel-disk
test:ci --test_output=errors --test_summary=terse

# Sanitizers: instrument everything, keep frame pointers and debug info,
# and make every finding fail the test.
build:asan --copt=-fsanitize=address --linkopt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer --copt=-O1 --copt=-g --strip=never
build:asan --linkopt=-fsanitize-link-c++-runtime
test:asan --test_env=ASAN_OPTIONS=detect_leaks=1:abort_on_error=1

build:ubsan --copt=-fsanitize=undefined --copt=-fno-sanitize-recover=all
build:ubsan --linkopt=-fsanitize=undefined --linkopt=-fsanitize-link-c++-runtime
build:ubsan --copt=-g --strip=never
test:ubsan --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1
