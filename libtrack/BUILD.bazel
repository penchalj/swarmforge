load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

STRICT_COPTS = [
    "-Wall",
    "-Wextra",
    "-Werror",
]

cc_library(
    name = "libtrack",
    srcs = ["src/kalman_cv.cc"],
    hdrs = ["include/libtrack/kalman_cv.h"],
    copts = STRICT_COPTS,
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

cc_test(
    name = "kalman_cv_test",
    size = "small",
    srcs = ["test/kalman_cv_test.cc"],
    copts = STRICT_COPTS,
    deps = [
        ":libtrack",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "sanitizer_canary_test",
    size = "small",
    srcs = ["test/sanitizer_canary_test.cc"],
    copts = STRICT_COPTS,
    tags = ["manual"],  # deliberately broken; run only by the sanitizer lane
    deps = ["@googletest//:gtest_main"],
)
